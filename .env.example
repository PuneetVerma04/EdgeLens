# Copy this file to .env and adjust as needed.

# MongoDB
MONGODB_URL=mongodb://localhost:27017        # use 'mongodb' instead of 'localhost' under Docker Compose
MONGODB_DB_NAME=edgelens_db
MONGODB_COLLECTION_NAME=inference_logs
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_FILE_SIZE_MB=5

# CORS (comma-separated origins). Note: read directly via os.getenv in main.py,
# not through the pydantic-settings layer the other variables above go through.
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Model
MODEL_PATH=./app/defect_detection_resnet_casting_data.pth
